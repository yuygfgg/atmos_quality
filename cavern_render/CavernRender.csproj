<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cavern-render</AssemblyName>
    <RootNamespace>CavernRender</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Headless Cavern renderer for DAMF/EC-3 masters with arbitrary object counts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cavern" Version="2.1.0" />
    <PackageReference Include="Cavern.Format" Version="2.1.0" />
  </ItemGroup>

</Project>
