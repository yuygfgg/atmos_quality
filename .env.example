# Copy to .env and adjust the paths for this machine.
AQ_GST_ROOT=/path/to/Dolby Reference Player.app/Contents/Frameworks/GStreamer.framework/Versions/1_16
AQ_GST_PLUGIN_PATH=/path/to/gst-plugin-oamd/build/cmake-x86_64/reference-player-plugins
AQ_DDPMETA=/path/to/ddpmeta/target/release/ddpmeta
AQ_CACHE=/path/to/cache
AQ_OUT=/path/to/reports

# Optional overrides (normally derived from AQ_GST_ROOT):
# AQ_GST_LAUNCH=/path/to/gst-launch-1.0
# AQ_GST_SCANNER=/path/to/gst-plugin-scanner
# AQ_GST_SYSTEM_PATH=/path/to/gstreamer-1.0

# Optional explicit env file:
# AQ_ENV_FILE=/path/to/.env
